@startuml diagrama-paquetes
title Diagrama de paquetes - applicacion

skinparam packageStyle folder
hide empty members
set separator none
allowmixing

' Dependencias obtenidas de los imports reales entre paquetes (una flecha = "usa a")

package "com.arquitecturajava" as raiz {
  component "ApplicacionApplication\n<<@SpringBootApplication>>" as app

  package "controllers" as controllers {
    rectangle "CursoController\nImparticionController\nMatriculaController\nProfesorController\nAlumnoController\nInicioController\nManejadorErrores" as pres_clases
  }

  package "viewmodels" as viewmodels {
    rectangle "CursoViewModel\nImparticionViewModel\nMatriculaViewModel\nProfesorViewModel\nAlumnoViewModel" as vm_clases
  }

  package "mapper" as mapper {
    rectangle "CursoMapper\nImparticionMapper\nMatriculaMapper\nProfesorMapper\nAlumnoMapper" as map_clases
  }

  package "servicios" as servicios {
    rectangle "CursoService\nImparticionService\nMatriculaService\nProfesorService\nAlumnoService\n+ excepciones de negocio" as serv_clases
  }

  package "repositories" as repositories {
    rectangle "CursoRepository\nCursoNivelRepository\nImparticionRepository\nMatriculaRepository\nProfesorRepository\nAlumnoRepository" as pers_clases
  }

  package "negocio" as negocio {
    rectangle "Curso\nCursoNivel\nImparticion\nProfesor\nAlumno\nMatricula" as neg_clases
  }
}

package "src/main/resources/templates" as templates {
  rectangle "cursos/  imparticiones/  matriculas/\nprofesores/  alumnos/  fragmentos/menu.html\nindex.html" as plantillas
}

controllers -down-> servicios : llama a
controllers -left-> mapper : convierte con
controllers -down-> viewmodels : recibe y envía
controllers .up.> templates : devuelve el nombre de la vista
mapper -down-> negocio
mapper -left-> viewmodels
servicios -down-> repositories : usa
servicios -down-> negocio
repositories -down-> negocio : gestiona

note right of controllers
  <b>controllers</b> no depende de <b>negocio</b>:
  los controllers solo ven ViewModels y
  los mappers hacen la conversión.
end note

note right of negocio
  <b>negocio</b> y <b>viewmodels</b> no dependen de
  ningún otro paquete de la aplicación
  (solo de JPA y Bean Validation).
end note

note left of servicios
  Única capa con @Transactional y reglas
  de negocio; las excepciones "no encontrado"
  se convierten en 404 en ManejadorErrores.
end note

@enduml
