@startuml diagrama-entidad-relacion
title Diagrama entidad-relación - applicacion (H2)

skinparam linetype ortho
hide circle
hide empty members

' Esquema generado por Hibernate a partir de las entidades CursoNivel, Curso, Imparticion, Profesor, Alumno y Matricula

entity "curso_nivel" as curso_nivel {
  * id : BIGINT <<PK>> <<IDENTITY>>
  --
  nombre : VARCHAR(255)
  * orden : INTEGER
}

entity "curso" as curso {
  * id : BIGINT <<PK>> <<IDENTITY>>
  --
  titulo : VARCHAR(255)
  autor : VARCHAR(255)
  * duracion : INTEGER {<= 200}
  id_nivel : BIGINT <<FK>>
}

entity "imparticion" as imparticion {
  * id : BIGINT <<PK>> <<IDENTITY>>
  --
  nombre : VARCHAR(255)
  fecha_inicio : DATE
  fecha_fin : DATE
  curso_id : BIGINT <<FK>>
  * profesor_id : BIGINT <<FK>>
}

entity "profesor" as profesor {
  * id : BIGINT <<PK>> <<IDENTITY>>
  --
  dni : VARCHAR(255) <<UNIQUE>>
  nombre : VARCHAR(255)
  apellidos : VARCHAR(255)
}

entity "alumno" as alumno {
  * id : BIGINT <<PK>> <<IDENTITY>>
  --
  dni : VARCHAR(255) <<UNIQUE>>
  nombre : VARCHAR(255)
  apellidos : VARCHAR(255)
  email : VARCHAR(255)
}

curso_nivel ||--o{ curso : "id_nivel → id"
curso ||--o{ imparticion : "curso_id → id"
profesor ||--o{ imparticion : "profesor_id → id"

entity "matricula" as matricula {
  * id : BIGINT <<PK>> <<IDENTITY>>
  --
  fecha : DATE
  * alumno_id : BIGINT <<FK>>
  * imparticion_id : BIGINT <<FK>>
  <<UNIQUE (alumno_id, imparticion_id)>>
}

imparticion ||--o{ matricula : "imparticion_id → id"
alumno ||--o{ matricula : "alumno_id → id"

note right of matricula
  Los borrados en cascada (CascadeType.REMOVE)
  los aplica JPA, no la base de datos:
  ninguna FK tiene ON DELETE CASCADE.
  Al borrar una imparticion JPA borra sus matriculas.
  Un profesor con imparticiones o un alumno con
  matriculas no se pueden borrar.
end note


legend right
  * = NOT NULL
end legend

@enduml
