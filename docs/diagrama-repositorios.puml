@startuml diagrama-repositorios
title Diagrama de clases - jerarquía de repositorios

scale 0.8

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members
set separator none

package "org.springframework.data.repository" {
  interface "Repository<T, ID>" as Repository <<Marker>>

  interface "CrudRepository<T, ID>" as CrudRepository {
    + <b>save(entity : S) : S</b>
    + saveAll(entities : Iterable<S>) : Iterable<S>
    + <b>findById(id : ID) : Optional<T></b>
    + existsById(id : ID) : boolean
    + <b>findAll() : Iterable<T></b>
    + findAllById(ids : Iterable<ID>) : Iterable<T>
    + count() : long
    + deleteById(id : ID) : void
    + delete(entity : T) : void
    + deleteAll() : void
  }

  interface "ListCrudRepository<T, ID>" as ListCrudRepository {
    + saveAll(entities : Iterable<S>) : List<S>
    + <b>findAll() : List<T></b>
    + findAllById(ids : Iterable<ID>) : List<T>
  }
}

package "org.springframework.data.jpa.repository" {
  interface "JpaRepository<T, ID>" as JpaRepository {
    + flush() : void
    + saveAndFlush(entity : S) : S
    + deleteAllInBatch() : void
    + getReferenceById(id : ID) : T
    + <b>findAll(example : Example<S>) : List<S></b>
  }
}

package "com.arquitecturajava.persistencia" {
  interface CursoNivelRepository <<Repository>> {
    + findAllByOrderByOrdenAsc() : List<CursoNivel>
  }

  interface CursoRepository <<Repository>> {
    + findByTituloStartingWithIgnoreCase(titulo : String) : List<Curso>
    + findByAutorStartingWithIgnoreCase(autor : String) : List<Curso>
    + findByNivelNombreStartingWithIgnoreCase(nivel : String) : List<Curso>
  }

  interface ImparticionRepository <<Repository>> {
    + findByCursoIdOrderByFechaInicioAsc(cursoId : Long) : List<Imparticion>
    + findByIdAndCursoId(id : Long, cursoId : Long) : Optional<Imparticion>
  }

  interface ProfesorRepository <<Repository>> {
    + findAllByOrderByApellidosAscNombreAsc() : List<Profesor>
    + findByNombreContainingIgnoreCaseOrderByApellidosAscNombreAsc(nombre : String) : List<Profesor>
    + findByApellidosContainingIgnoreCaseOrderByApellidosAscNombreAsc(apellidos : String) : List<Profesor>
    + existsByDniIgnoreCase(dni : String) : boolean
    + existsByDniIgnoreCaseAndIdNot(dni : String, id : Long) : boolean
  }

  interface MatriculaRepository <<Repository>> {
    + findByImparticionIdOrderByAlumnoApellidosAscAlumnoNombreAsc(imparticionId : Long) : List<Matricula>
    + findByAlumnoIdOrderByFechaDesc(alumnoId : Long) : List<Matricula>
    + findByIdAndImparticionId(id : Long, imparticionId : Long) : Optional<Matricula>
    + existsByAlumnoIdAndImparticionId(alumnoId : Long, imparticionId : Long) : boolean
  }

  interface AlumnoRepository <<Repository>> {
    + findAllByOrderByApellidosAscNombreAsc() : List<Alumno>
    + existsByDniIgnoreCase(dni : String) : boolean
    + existsByDniIgnoreCaseAndIdNot(dni : String, id : Long) : boolean
  }
}

package "com.arquitecturajava.negocio" {
  class CursoNivel <<Entity>>
  class Curso <<Entity>>
  class Imparticion <<Entity>>
  class Profesor <<Entity>>
  class Alumno <<Entity>>
  class Matricula <<Entity>>
}

Repository <|-down- CrudRepository
CrudRepository <|-down- ListCrudRepository
ListCrudRepository <|-down- JpaRepository
JpaRepository <|-down- CursoNivelRepository : <CursoNivel, Long>
JpaRepository <|-down- CursoRepository : <Curso, Long>
JpaRepository <|-down- ImparticionRepository : <Imparticion, Long>
JpaRepository <|-down- ProfesorRepository : <Profesor, Long>
JpaRepository <|-down- AlumnoRepository : <Alumno, Long>
JpaRepository <|-down- MatriculaRepository : <Matricula, Long>
CursoNivelRepository .down.> CursoNivel : gestiona >
CursoRepository .down.> Curso : gestiona >
ImparticionRepository .down.> Imparticion : gestiona >
ProfesorRepository .down.> Profesor : gestiona >
AlumnoRepository .down.> Alumno : gestiona >
MatriculaRepository .down.> Matricula : gestiona >

note right of CrudRepository
  <b>findById</b> es el antiguo <b>findOne(id)</b>:
  se renombró en Spring Data 2.0 y ahora
  devuelve un Optional<T>.
end note

note right of CursoRepository
  Solo se declaran las consultas propias:
  Spring Data genera la implementación en
  tiempo de ejecución a partir del nombre del
  método y hereda save, findAll, findById...
  con T = Curso e ID = Long.
end note

note right of ImparticionRepository
  findByCursoIdOrderByFechaInicioAsc lleva
  @EntityGraph(attributePaths = "profesor"):
  carga el profesor en la misma consulta
  para el listado (evita N+1).
  MatriculaRepository hace lo mismo con
  "alumno" y con "imparticion.curso".
end note

@enduml
